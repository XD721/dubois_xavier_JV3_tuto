def etape_03_transfert_global():
    eal = unreal.EditorAssetLibrary()
    at = unreal.AssetToolsHelpers.get_asset_tools()

    unreal.EditorLoadingAndSavingUtils.save_dirty_packages(True, True)
    
    # 1. TRAITEMENT DES DOSSIERS COMPLETS
    folder_tasks = [
        ("/Game/Characters", "/Game/Project/Animations/Player"), # Tout ce qui reste dans Characters
        ("/Game/LevelPrototyping", "/Game/_External"),
        ("/Game/FirstPerson/Anims", "/Game/Project/Animations/Player"),
        ("/Game/Input", "/Game/Project/Systems/Input") # Gère aussi le sous-dossier Actions
    ]

    assets_to_move = []

    for src_folder, dst_root in folder_tasks:
        if eal.does_directory_exist(src_folder):
            files = eal.list_assets(src_folder, recursive=True)
            
            for f_path in files:
                asset_obj = eal.load_asset(f_path)
                if not asset_obj: continue

                # Calcul intelligent du chemin de destination
                rel_path = f_path.replace(src_folder, "")
                path_only = unreal.Paths.get_path(rel_path)
                folder_name_src = src_folder.split("/")[-1]
                
                # Logique spéciale : éviter .../Input/Input/
                if folder_name_src == "Input":
                    final_folder = (dst_root + path_only).rstrip("/")
                else:
                    final_folder = (dst_root + "/" + folder_name_src + path_only).rstrip("/")

                assets_to_move.append(unreal.AssetRenameData(
                    asset=asset_obj,
                    new_package_path=final_folder,
                    new_name=unreal.SystemLibrary.get_object_name(asset_obj)
                ))

    # 2. TRAITEMENT DES FICHIERS UNIQUES (First Person BP & Maps)
    single_files = [
        ("/Game/FirstPerson/Lvl_FirstPerson", "/Game/_External/BaseTemplate"),
        ("/Game/FirstPerson/MI_FirstPersonColorway", "/Game/_External/BaseTemplate"),
        ("/Game/FirstPerson/Blueprints/BP_FirstPersonPlayerController", "/Game/Project/Blueprints/Core"),
        ("/Game/FirstPerson/Blueprints/BP_FirstPersonGameMode", "/Game/Project/Blueprints/Core"),
        ("/Game/FirstPerson/Blueprints/BP_FirstPersonCameraManager", "/Game/Project/Blueprints/Core"),
        ("/Game/FirstPerson/Blueprints/BP_FirstPersonCharacter", "/Game/Project/Blueprints/Characters/Player"),
        ("/Game/Input/Touch", "/Game/Project/UI/Blueprints") # Cas spécial Touch
    ]

    for src, dst in single_files:
        if eal.does_asset_exist(src):
            obj = eal.load_asset(src)
            assets_to_move.append(unreal.AssetRenameData(
                asset=obj,
                new_package_path=dst,
                new_name=unreal.SystemLibrary.get_object_name(obj)
            ))
        elif eal.does_directory_exist(src): # Pour Touch qui est un dossier
             files = eal.list_assets(src, recursive=True)
             for f in files:
                 o = eal.load_asset(f)
                 assets_to_move.append(unreal.AssetRenameData(asset=o, new_package_path=dst, new_name=unreal.SystemLibrary.get_object_name(o)))


    # EXÉCUTION
    if len(assets_to_move) > 0:
        unreal.log(f"Transfert de {len(assets_to_move)} fichiers...")
        at.rename_assets(assets_to_move)
        unreal.EditorLoadingAndSavingUtils.save_dirty_packages(True, True)
    
    unreal.log("SCRIPT 3 TERMINÉ : Migration globale effectuée.")

etape_03_transfert_global()
