import os

def etape_01_structure_clean():
    eal = unreal.EditorAssetLibrary()
    
    # Données basées sur votre ListeDesDossiers.txt
    folders_data = [
        # --- AI ---
        ("Project/AI/BehaviorTrees", "Le flux de décision principal (BT_)."),
        ("Project/AI/BehaviorTrees/Tasks", "Actions personnalisées du Behavior Tree (BTT_)."),
        ("Project/AI/BehaviorTrees/Decorators", "Conditions pour bloquer ou autoriser l'exécution (BTD_)."),
        ("Project/AI/BehaviorTrees/Services", "Mises à jour régulières des variables (BTS_)."),
        ("Project/AI/StateTrees", "Arbres d'états pour la logique et la prise de décision (ST_)."),
        ("Project/AI/StateTrees/Tasks", "Actions spécifiques exécutées dans les états (STT_)."),
        ("Project/AI/StateTrees/Evaluators", "Évaluateurs pour calculer des données avant transition (STE_)."),
        ("Project/AI/StateTrees/Conditions", "Conditions pour valider les transitions entre les états (STC_)."),
        ("Project/AI/Blackboards", "La mémoire de l'IA (BB_)."),
        ("Project/AI/Controllers", "L'acteur qui possède et guide le NPC (AIC_)."),

         # --- ANIMATIONS ---
        ("Project/Animations/Player", "Contient les AnimBP, BlendSpaces et Séquences du joueur."),
        ("Project/Animations/NPCs", "Anims des ennemis et PNJs."),

         # --- AUDIO ---
        ("Project/Audio/Music", "Pour les musiques de fond et d'ambiance."),
        ("Project/Audio/SFX", "Pour les bruitages courts (tirs, pas, impacts)."),

         # --- BLUEPRINTS ---
        ("Project/Blueprints/Actors", "Objets interactifs du monde (portes, items, pièges)."),
        ("Project/Blueprints/Components", "Composants réutilisables à ajouter aux acteurs."),
        ("Project/Blueprints/Core", "LE CADRE : GameMode, PlayerController, GameInstance."),
        ("Project/Blueprints/Interfaces", "Blueprint Interfaces pour la communication."),
        ("Project/Blueprints/Characters/Player", "Le héros contrôlé par le joueur."),
        ("Project/Blueprints/Characters/NPCs", "Les ennemis et personnages Non-Joueurs."),

        # --- MAPS ---
        ("Project/Maps/Development", "Niveaux de test et bacs à sable."),
        ("Project/Maps/Main", "Les niveaux officiels du jeu final."),

        # --- MATERIALS ---
        ("Project/Materials/Master", "Les matériaux parents complexes."),
        ("Project/Materials/Instances", "Les instances (MI_) pour changer les couleurs/textures."),

        # --- MESHES ---
        ("Project/Meshes/Props", "Objets statiques de décor (SM_)."),
        ("Project/Meshes/Characters", "Modèles 3D des personnages (Skeletal Meshes)."),
	    ("Project/Meshes/Destructibles/GeometryCollections", "Les objets 3D fracturés (GC_)."),
        ("Project/Meshes/Destructibles/Fields", "Blueprints Field System pour diriger et contrôler les brisures (FS_)."),

        # --- TEXTURES & VFX ---
        ("Project/Textures", "Toutes les images importées."),
        ("Project/VFX/Niagara", "Particules et Effets Visuels."),

        # --- SYSTEMS ---
        ("Project/Systems/Enums", "Enumerations (Listes d'états)."),
        ("Project/Systems/Input", "Fichiers Enhanced Input (IMC_, IA_)."),
        ("Project/Systems/Save_Data", "Système de sauvegarde."),
        ("Project/Systems/Structs", "Structures de données."),

        # --- UI ---
        ("Project/UI/Blueprints", "Les Widgets (WBP_) pour l'interface."),
        ("Project/UI/Fonts", "Polices d'écriture."),
        ("Project/UI/Assets", "Images spécifiques à l'interface.")
    ]

    # 1. Création du dossier spécial _External
    eal.make_directory("/Game/_External/BaseTemplate")
    
    # 2. Boucle de création des dossiers et fichiers .txt
    content_dir = unreal.Paths.project_content_dir()
    
    for path, desc in folders_data:
        ue_path = "/Game/" + path
        eal.make_directory(ue_path)
        
        # Création physique du fichier description
        full_disk_path = os.path.join(content_dir, path)
        if not os.path.exists(full_disk_path):
            os.makedirs(full_disk_path)
            
        desc_file = os.path.join(full_disk_path, "DescriptionDossier.txt")
        with open(desc_file, "w", encoding="utf-8") as f:
            f.write(desc)

    unreal.log("SCRIPT 1 TERMINÉ : Structure et documentation créées.")

